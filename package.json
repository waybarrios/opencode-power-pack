{
  "name": "opencode-power-pack",
  "version": "0.2.0",
  "description": "Eleven Claude Code workflows packaged for Codex and OpenCode: code review, feature development, security review, frontend design, authoring, and project memory.",
  "type": "module",
  "main": ".opencode/plugins/opencode-power-pack.js",
  "engines": {
    "node": ">=20",
    "opencode": ">=1.18.7"
  },
  "files": [
    "skills",
    ".codex-plugin",
